---
interface Props {
  subject?: string;
}
const { subject = "overtime" } = Astro.props;
---

<div class="callout callout-payroll" role="note">
  <strong class="text-ink">Income-tax deduction only.</strong>
  This is an income-tax deduction estimate. Social Security and Medicare (FICA) taxes on {subject} still apply.
</div>
