---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Something went wrong | NoTaxOTCalculator"
  description="Temporary error on NoTaxOTCalculator."
  canonicalPath="/500"
  noindex={true}
>
  <SiteHeader slot="header" />
  <div class="site-wrap py-20 text-center">
    <p class="font-mono text-xs uppercase tracking-wide text-mute">500</p>
    <h1 class="mt-2 text-3xl tracking-tight">Something went wrong</h1>
    <p class="mt-3 text-body">Please try again in a moment.</p>
    <p class="mt-6">
      <a href="/" class="btn-primary no-underline">Back to home</a>
    </p>
  </div>
  <SiteFooter slot="footer" />
</BaseLayout>
